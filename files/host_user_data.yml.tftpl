#cloud-config
packages:
  - amazon-cloudwatch-agent
  - logrotate
  - nfs-utils

write_files:
  - path: /etc/ecs/ecs.config
    content: |
      ECS_CLUSTER=${cluster_name}
      ECS_LOGFILE=/var/log/ecs-agent.log
      ECS_UPDATES_ENABLED=true
      ECS_UPDATE_DOWNLOAD_DIR=/cache
      ECS_AVAILABLE_LOGGING_DRIVERS=["awslogs","fluentd","json-file","none"]
      ECS_ENABLE_TASK_IAM_ROLE=true

  # The CloudWatch agent can't read the journal, so it's followed into a
  # file the agent ships, and rotated by logrotate
  - path: /etc/systemd/system/journal-export.service
    content: |
      [Unit]
      Description=Copy the system journal to /var/log/journal-export.log
      After=systemd-journald.service

      [Service]
      ExecStart=/bin/sh -c 'exec journalctl --follow --boot --no-tail --cursor-file=/var/lib/journal-export.cursor --output=short-iso >> /var/log/journal-export.log'
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

  - path: /etc/logrotate.d/journal-export
    content: |
      /var/log/journal-export.log {
        daily
        rotate 2
        maxsize 100M
        missingok
        notifempty
        compress
        copytruncate
      }

  - path: /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
    content: |
      {
        "agent": {
          "run_as_user": "root"
        },
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "/var/log/journal-export.log",
                  "log_group_name": "${log_group_name}",
                  "log_stream_name": "{instance_id}/journal"
                },
                {
                  "file_path": "/var/log/ecs/ecs-init.log",
                  "log_group_name": "${log_group_name}",
                  "log_stream_name": "{instance_id}/ecs-init.log"
                },
                {
                  "file_path": "/var/log/ecs/ecs-agent.log*",
                  "log_group_name": "${log_group_name}",
                  "log_stream_name": "{instance_id}/ecs-agent.log"
                },
                {
                  "file_path": "/var/log/ecs/audit.log*",
                  "log_group_name": "${log_group_name}",
                  "log_stream_name": "{instance_id}/audit.log"
                }
              ]
            }
          }
        }
      }

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now journal-export.service
  - /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

users: %{ for user in users ~}
  - name: ${user.name}
    sudo: [ "ALL=(ALL) NOPASSWD:ALL" ]
    shell: /bin/bash
    ssh-authorized-keys:
    - ${user.ssh}
%{ endfor ~}
